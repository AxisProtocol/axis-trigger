// Prisma schema for PostgreSQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Price {
  id             BigInt   @id @default(autoincrement())
  symbol         String
  source         String
  price          Decimal  @db.Decimal(20, 10)
  priceTimestamp DateTime @db.Timestamptz(3)

  @@index([symbol, priceTimestamp])
  @@unique([symbol, priceTimestamp, source])
}


