// Prisma schema for PostgreSQL
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Price {
  id             BigInt   @id @default(autoincrement())
  symbol         String
  source         String
  price          Decimal  @db.Decimal(20, 10)
  priceTimestamp DateTime @db.Timestamptz(3)

  @@index([symbol, priceTimestamp])
  @@unique([symbol, priceTimestamp, source])
}

model Asset {
  id                       BigInt   @id @default(autoincrement())
  symbol                   String   @unique
  coingeckoId              String?
  binanceSymbol            String?
  circulatingSupply        Decimal  @db.Decimal(38, 18)
  foundationHoldings       Decimal  @db.Decimal(38, 18) @default(0)
  lockedSupply             Decimal  @db.Decimal(38, 18) @default(0)
  heavilyVestedStaked      Decimal  @db.Decimal(38, 18) @default(0)
  exchangeCustodyHoldings  Decimal  @db.Decimal(38, 18) @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}


