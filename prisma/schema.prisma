// Prisma schema for PostgreSQL
generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Price {
  id             Int       @id @default(autoincrement())
  symbol         String
  source         String
  price          Decimal
  priceTimestamp DateTime

  @@index([symbol, priceTimestamp])
  @@unique([symbol, priceTimestamp, source])
}

model Asset {
  id                       Int      @id @default(autoincrement())
  symbol                   String   @unique
  coingeckoId              String?
  binanceSymbol            String?
  circulatingSupply        Decimal
  foundationHoldings       Decimal  @default(0)
  lockedSupply             Decimal  @default(0)
  heavilyVestedStaked      Decimal  @default(0)
  exchangeCustodyHoldings  Decimal  @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}


model Meta {
  /// Meta holds small key-value configuration/state used by the index engine.
  /// Example keys: FAMC_BASE_DATE, FAMC_BASE_SUM, FAMC_BASE_INDEX, FAMC_DIVISOR, FAMC_SET_HASH
  key   String @id
  value String
}


