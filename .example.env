# Copy this file to .env and fill in values for local testing
#
# Core
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Use bundled JSON (recommended). Keep file at src/assets.json and set:
ASSET_CONFIG_FILE="assets.json"

# Or use env-defined assets instead of JSON (leave ASSET_CONFIG_FILE unset)
# ASSETS="BTC,ETH"
# BTC_CIRCULATING_SUPPLY=19700000
# BTC_FOUNDATION_HOLDINGS=0
# BTC_LOCKED_SUPPLY=0
# BTC_HEAVILY_VESTED=0
# BTC_EXCHANGE_CUSTODY=3000000
# BTC_COINGECKO_ID=bitcoin
# ETH_CIRCULATING_SUPPLY=120000000
# ETH_FOUNDATION_HOLDINGS=0
# ETH_LOCKED_SUPPLY=0
# ETH_HEAVILY_VESTED=0
# ETH_EXCHANGE_CUSTODY=0
# ETH_COINGECKO_ID=ethereum

# Scheduling
CRON_SCHEDULE="0 * * * *"
CRON_TZ="UTC"
CRON_BACKFILL_DAYS=7

# CoinGecko API (one of these)
# COINGECKO_PRO_API_KEY=""
# COINGECKO_API_KEY=""
# X_CG_API_KEY="" # alias of COINGECKO_API_KEY
# COINGECKO_BASE_URL="" # optional override
CG_RANGE_MAX_DAYS=30

# Security for POST /api/update
UPDATE_ACCESS_KEY="dev-secret"

# Helius Webhook Configuration
HELIUS_WEBHOOK_TOKEN="Bearer your-webhook-token-here"

# Solana Configuration

# Local testing commands (reference)
# 1) Install deps and init DB
#    pnpm install && pnpm db:push
# 2) Seed assets JSON and upsert Asset rows
#    pnpm assets:update
# 3) Backfill historical prices (change date as needed)
#    START_DATE=2024-08-01 pnpm backfill:prices
# 4) Run local server (OpenAPI at /docs)
#    pnpm dev  # http://localhost:8788
# 5) Test endpoints
#    curl "http://localhost:8788/api/famc?resolution=60"
#    curl http://localhost:8788/api/avgindexprice
#    curl http://localhost:8788/api/famcindexprice
#    curl -X POST -H "x-update-key: $UPDATE_ACCESS_KEY" http://localhost:8788/api/update

